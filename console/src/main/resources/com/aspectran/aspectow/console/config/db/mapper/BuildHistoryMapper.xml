<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.aspectran.aspectow.console.build.audit.BuildHistoryMapper">

    <cache />

    <resultMap id="BuildHistoryResultMap" type="com.aspectran.aspectow.console.build.audit.BuildHistory">
        <id property="historyId" column="history_id" />
        <result property="executionId" column="execution_id" />
        <result property="targetNodeId" column="target_node_id" />
        <result property="scriptName" column="script_name" />
        <result property="requester" column="requester" />
        <result property="status" column="status" />
        <result property="exitCode" column="exit_code" />
        <result property="startedAt" column="started_at" />
        <result property="finishedAt" column="finished_at" />
        <result property="durationMs" column="duration_ms" />
        <result property="gitBranch" column="git_branch" />
        <result property="gitCommitBefore" column="git_commit_before" />
        <result property="gitCommitAfter" column="git_commit_after" />
        <result property="gitCommitMsg" column="git_commit_msg" />
        <result property="integrityHash" column="integrity_hash" />
        <result property="errorSummary" column="error_summary" />
        <result property="createdAt" column="created_at" />
        <association property="buildLog" column="history_id" select="getBuildLogByHistoryId" />
    </resultMap>

    <resultMap id="BuildHistorySummaryMap" type="com.aspectran.aspectow.console.build.audit.BuildHistory">
        <id property="historyId" column="history_id" />
        <result property="executionId" column="execution_id" />
        <result property="targetNodeId" column="target_node_id" />
        <result property="scriptName" column="script_name" />
        <result property="requester" column="requester" />
        <result property="status" column="status" />
        <result property="exitCode" column="exit_code" />
        <result property="startedAt" column="started_at" />
        <result property="finishedAt" column="finished_at" />
        <result property="durationMs" column="duration_ms" />
        <result property="gitBranch" column="git_branch" />
        <result property="gitCommitBefore" column="git_commit_before" />
        <result property="gitCommitAfter" column="git_commit_after" />
        <result property="gitCommitMsg" column="git_commit_msg" />
        <result property="integrityHash" column="integrity_hash" />
        <result property="errorSummary" column="error_summary" />
        <result property="createdAt" column="created_at" />
    </resultMap>

    <resultMap id="BuildLogResultMap" type="com.aspectran.aspectow.console.build.audit.BuildLog">
        <id property="logId" column="log_id" />
        <result property="historyId" column="history_id" />
        <result property="executionId" column="execution_id" />
        <result property="logContent" column="log_content" />
        <result property="compressedYn" column="compressed_yn" />
        <result property="lineCount" column="line_count" />
        <result property="byteSize" column="byte_size" />
        <result property="createdAt" column="created_at" />
    </resultMap>

    <insert id="insertBuildHistory" parameterType="com.aspectran.aspectow.console.build.audit.BuildHistory" useGeneratedKeys="true" keyProperty="historyId">
        insert into asc_build_history (
            execution_id, target_node_id, script_name, requester, status,
            exit_code, started_at, finished_at, duration_ms,
            git_branch, git_commit_before, git_commit_after, git_commit_msg,
            integrity_hash, error_summary
        ) values (
            #{executionId}, #{targetNodeId}, #{scriptName}, #{requester}, #{status},
            #{exitCode}, #{startedAt}, #{finishedAt}, #{durationMs},
            #{gitBranch}, #{gitCommitBefore}, #{gitCommitAfter}, #{gitCommitMsg},
            #{integrityHash}, #{errorSummary}
        )
    </insert>

    <update id="updateBuildHistory" parameterType="com.aspectran.aspectow.console.build.audit.BuildHistory">
        update asc_build_history
        set status = #{status},
            exit_code = #{exitCode},
            finished_at = #{finishedAt},
            duration_ms = #{durationMs},
            git_branch = #{gitBranch},
            git_commit_before = #{gitCommitBefore},
            git_commit_after = #{gitCommitAfter},
            git_commit_msg = #{gitCommitMsg},
            integrity_hash = #{integrityHash},
            error_summary = #{errorSummary}
        where history_id = #{historyId}
    </update>

    <select id="getBuildHistoryById" parameterType="long" resultMap="BuildHistoryResultMap">
        select * from asc_build_history where history_id = #{historyId}
    </select>

    <select id="getBuildHistoryByExecutionId" parameterType="string" resultMap="BuildHistoryResultMap">
        select * from asc_build_history where execution_id = #{executionId}
    </select>

    <select id="getLatestBuildHistoryByNodeId" parameterType="string" resultMap="BuildHistoryResultMap">
        select * from asc_build_history
        where target_node_id = #{targetNodeId}
        order by history_id desc
        limit 1
    </select>

    <select id="getLatestBuildHistories" resultMap="BuildHistorySummaryMap">
        select h.*
        from asc_build_history h
        inner join (
            select target_node_id, max(history_id) as max_history_id
            from asc_build_history
            <where>
                <if test="targetNodeIds != null and targetNodeIds.size() > 0">
                    and target_node_id in
                    <foreach item="nodeId" collection="targetNodeIds" open="(" separator="," close=")">
                        #{nodeId}
                    </foreach>
                </if>
            </where>
            group by target_node_id
        ) latest on h.history_id = latest.max_history_id
        order by h.history_id desc
    </select>

    <sql id="searchCriteria">
        <where>
            <if test="targetNodeId != null and targetNodeId != ''">
                and target_node_id = #{targetNodeId}
            </if>
            <if test="scriptName != null and scriptName != ''">
                and script_name = #{scriptName}
            </if>
            <if test="requester != null and requester != ''">
                and requester = #{requester}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
            <if test="startDate != null and startDate != ''">
                and started_at &gt;= #{startDate}
            </if>
            <if test="endDate != null and endDate != ''">
                and started_at &lt;= #{endDate}
            </if>
            <if test="searchKeyword != null and searchKeyword != ''">
                and (
                    lower(execution_id) like lower(concat('%', #{searchKeyword}, '%'))
                    or lower(target_node_id) like lower(concat('%', #{searchKeyword}, '%'))
                    or lower(script_name) like lower(concat('%', #{searchKeyword}, '%'))
                    or lower(requester) like lower(concat('%', #{searchKeyword}, '%'))
                    or lower(git_branch) like lower(concat('%', #{searchKeyword}, '%'))
                    or lower(git_commit_after) like lower(concat('%', #{searchKeyword}, '%'))
                    or lower(git_commit_msg) like lower(concat('%', #{searchKeyword}, '%'))
                )
            </if>
        </where>
    </sql>

    <select id="searchBuildHistory" parameterType="com.aspectran.aspectow.console.build.audit.BuildAuditQuery" resultMap="BuildHistorySummaryMap">
        select * from asc_build_history
        <include refid="searchCriteria" />
        order by history_id desc
        <if test="pageInfo != null">
            limit #{pageInfo.size} offset #{pageInfo.offset}
        </if>
    </select>

    <select id="countBuildHistory" parameterType="com.aspectran.aspectow.console.build.audit.BuildAuditQuery" resultType="long">
        select count(*) from asc_build_history
        <include refid="searchCriteria" />
    </select>

    <insert id="insertBuildLog" parameterType="com.aspectran.aspectow.console.build.audit.BuildLog" useGeneratedKeys="true" keyProperty="logId">
        insert into asc_build_log (
            history_id, execution_id, log_content, compressed_yn, line_count, byte_size
        ) values (
            #{historyId}, #{executionId}, #{logContent}, #{compressedYn}, #{lineCount}, #{byteSize}
        )
    </insert>

    <select id="getBuildLogByHistoryId" parameterType="long" resultMap="BuildLogResultMap">
        select * from asc_build_log where history_id = #{historyId}
    </select>

    <select id="getBuildLogByExecutionId" parameterType="string" resultMap="BuildLogResultMap">
        select * from asc_build_log where execution_id = #{executionId}
    </select>

    <delete id="purgeOldHistories" parameterType="int">
        delete from asc_build_history
        where created_at &lt; date_sub(current_timestamp, interval #{retentionDays} day)
    </delete>

</mapper>
