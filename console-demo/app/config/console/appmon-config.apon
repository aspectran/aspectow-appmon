# Polling configuration used only when WebSocket is not supported
pollingConfig: {
    # The interval in milliseconds at which the client polls the server for new messages
    pollingInterval: 3000
    # The duration in milliseconds after which an inactive polling session expires
    sessionTimeout: 30000
}
counterPersistInterval: 5
app: {
    id: console-visible
    title: Visible Console
    event: {
        id: activity
        target: console
        parameters: {
            +: /**
            -: /nodes/**/polling/**  # Ignore polling requests
        }
    }
    event: {
        id: session
        target: netty.server/console
    }
    metric: {
        id: cpu
        title: CPU
        description: Shows JVM process and system CPU usage
        reader: com.aspectran.aspectow.appmon.engine.exporter.metric.jvm.CpuUsageReader
        sampleInterval: 1000
    }
    metric: {
        id: heap
        title: Heap
        description: Shows JVM Heap memory usage status
        reader: com.aspectran.aspectow.appmon.engine.exporter.metric.jvm.HeapMemoryUsageReader
        sampleInterval: 500
    }
    log: {
        id: app
        file: console.log
        sampleInterval: 300
        lastLines: 100
    }
    log: {
        id: access
        file: console-access.log
        sampleInterval: 300
        lastLines: 100
    }
}
app: {
    id: console-hidden
    node: console-node1
    title: Hidden Console
    hidden: true
    event: {
        id: activity
        target: console
        parameters: {
            +: /**
            -: /nodes/**/polling/**  # Ignore polling requests
        }
    }
    event: {
        id: session
        target: netty.server/console
    }
    log: {
        id: app
        file: console.log
        sampleInterval: 300
        lastLines: 100
    }
    log: {
        id: access
        file: console-access.log
        sampleInterval: 300
        lastLines: 100
    }
}
app: {
    id: console-root
    title: Root
    event: {
        id: activity
        target: root
        parameters: {
            +: /**
            -: /nodes/**/appmon/polling/**  # Ignore polling requests
        }
    }
    metric: {
        id: cpu
        title: CPU
        description: Shows JVM process and system CPU usage
        reader: com.aspectran.aspectow.appmon.engine.exporter.metric.jvm.CpuUsageReader
        sampleInterval: 1000
        heading: true
    }
    metric: {
        id: heap
        title: Heap
        description: Shows JVM Heap memory usage status
        reader: com.aspectran.aspectow.appmon.engine.exporter.metric.jvm.HeapMemoryUsageReader
        sampleInterval: 500
        heading: true
    }
    metric: {
        id: netty-tp
        title: Netty TP
        description: Metrics of Netty thread pool resources
        reader: com.aspectran.aspectow.appmon.engine.exporter.metric.netty.NettyThreadPoolMetricsReader
        target: netty.server
        sampleInterval: 30
        exportInterval: 900
        heading: true
    }
    event: {
        id: session
        target: netty.server/root
    }
    log: {
        id: app
        file: root.log
        sampleInterval: 300
        lastLines: 30
    }
    log: {
        id: access
        file: root-access.log
        sampleInterval: 300
        lastLines: 60
    }
}
